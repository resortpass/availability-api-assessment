# Application
PORT=3000
NODE_ENV=development

# Database (for production PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=availability_db
DB_USER=postgres
DB_PASSWORD=

# 3rd Party API
THIRD_PARTY_API_URL=http://localhost:3001
THIRD_PARTY_API_KEY=mock-api-key

# Mock API only: fraction (0..1) of availability requests that fail randomly.
# Defaults to 0 (deterministic). Use ?simulate=failure to force a 503 instead.
# FAILURE_RATE=0
